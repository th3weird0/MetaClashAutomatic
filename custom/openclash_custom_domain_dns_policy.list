# 文件作用：按 GEO 分类与显式域名分配 DNS，不依赖转换器生成的规则源名称。
# 不引用旧模块的 rule-set 名称，避免停用模块后 DNS 策略出现悬空引用。
"+.cn": ["https://dns.alidns.com/dns-query", "tls://dot.pub"]
"geosite:cn": ["https://dns.alidns.com/dns-query", "https://doh.pub/dns-query", "tls://dot.pub"]
"geosite:geolocation-!cn": ["https://1.1.1.1/dns-query", "https://8.8.8.8/dns-query"]
