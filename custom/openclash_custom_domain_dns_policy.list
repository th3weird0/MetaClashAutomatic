"+.github.com": ["https://1.1.1.1/dns-query", "https://8.8.8.8/dns-query"]
"+.youtube.com": ["https://1.1.1.1/dns-query", "https://8.8.8.8/dns-query"]
"+.bilibili.com": ["https://dns.alidns.com/dns-query", "https://doh.pub/dns-query", "tls://dot.pub"]
"+.qq.com": ["https://dns.alidns.com/dns-query", "https://doh.pub/dns-query", "tls://dot.pub"]
