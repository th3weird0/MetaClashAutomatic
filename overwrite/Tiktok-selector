[YAML]
# 文件作用：保留 TikTok 分流规则，出口改用模板社交媒体组，并保留显示顺序处理。
# TikTok (international) selector.
# The rule provider is blackmatrix7's TikTok collection, updated 2026-10-16.
# The post-merge edit places the group at final position 7 (zero-based index 6).
# Update the existing template group; do not create a duplicate name.
proxy-groups*:
  where:
    name: "🌐 社交媒体"
  set:
    type: select
    proxies:
      - "🚀 手动选择"
      - "♻️ 自动选择"
      - "🇸🇬 新加坡节点"
      - "🇭🇰 香港节点"
      - "🇼🇸 台湾节点"
      - "🇯🇵 日本节点"
      - "🇺🇸 美国节点"
      - "🇰🇷 韩国节点"
      - DIRECT

+rule-providers:
  TikTok:
    type: http
    behavior: classical
    format: yaml
    path: ./rule_provider/TikTok.yaml
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/TikTok/TikTok.yaml
    interval: 172800

+rules:
  - GEOSITE,tiktok,🌐 社交媒体
  - RULE-SET,TikTok,🌐 社交媒体

[General]
CONFIG_FILE = /etc/openclash/config/超级自动挡.yaml

[Overwrite]
ruby_edit "$CONFIG_FILE" "['proxy-groups']" "if Value['proxy-groups'].is_a?(Array) then i = Value['proxy-groups'].index { |x| x.is_a?(Hash) && x['name'] == '🌐 社交媒体' }; if i && i != 6 then x = Value['proxy-groups'].delete_at(i); Value['proxy-groups'].insert(6, x) end end; Value['proxy-groups']"
