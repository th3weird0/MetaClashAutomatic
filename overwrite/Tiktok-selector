[YAML]
# 文件作用：添加 TikTok 手动策略组与分流规则，并固定策略组显示顺序。
# TikTok (international) selector.
# The rule provider is blackmatrix7's TikTok collection, updated 2026-10-16.
# The post-merge edit places the group at final position 7 (zero-based index 6).
+proxy-groups:
  - name: "🎵 国外Tiktok"
    type: select
    proxies:
      - "🚀 节点选择"
      - "♻️ 自动选择"
      - "🇸🇬 狮城节点"
      - "🇭🇰 香港节点"
      - "🇨🇳 台湾节点"
      - "🇯🇵 日本节点"
      - "🇺🇲 美国节点"
      - "🇰🇷 韩国节点"
      - "🚀 手动切换"
      - DIRECT

+rule-providers:
  TikTok:
    type: http
    behavior: classical
    format: yaml
    path: ./rule_provider/TikTok.yaml
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/TikTok/TikTok.yaml
    interval: 86400

+rules:
  - GEOSITE,tiktok,🎵 国外Tiktok
  - RULE-SET,TikTok,🎵 国外Tiktok

[General]
CONFIG_FILE = /etc/openclash/config/超级自动挡.yaml

[Overwrite]
ruby_edit "$CONFIG_FILE" "['proxy-groups']" "if Value['proxy-groups'].is_a?(Array) then i = Value['proxy-groups'].index { |x| x.is_a?(Hash) && x['name'] == '🎵 国外Tiktok' }; if i && i != 6 then x = Value['proxy-groups'].delete_at(i); Value['proxy-groups'].insert(6, x) end end; Value['proxy-groups']"
