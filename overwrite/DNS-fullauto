# 文件作用：集中管理 Mihomo DNS 基础参数，保留 LuCI 配置的 Nameserver-Policy。
# DNS-fullauto：本项目Mihomo DNS基础参数的唯一自建配置来源。
# 适用超级自动挡配置；旧hook不再承担DNS覆写。
# CUSTOM_NAME_POLICY不在这里固定，保留LuCI开关控制输入框加载。
[General]
ENABLE_CUSTOM_DNS = 0
APPEND_WAN_DNS = 0
APPEND_DEFAULT_DNS = 0
CUSTOM_FALLBACK_FILTER = 0
ENABLE_RESPECT_RULES = 1
DNS_PORT = 7874
IPV6_DNS = 0

[YAML]
# 整套Mihomo DNS基础参数只在本模块维护；Policy不复制到模块。
dns:
  enable: true
  ipv6: false
  enhanced-mode: redir-host
  listen: 0.0.0.0:7874
  respect-rules: true
  use-hosts: true
  default-nameserver:
  - https://223.5.5.5/dns-query#DIRECT
  nameserver:
  - https://1.1.1.1/dns-query
  - https://8.8.8.8/dns-query
  proxy-server-nameserver:
  - 223.5.5.5
  - 119.29.29.29
  - https://223.5.5.5/dns-query
  - tls://1.1.1.1
  direct-nameserver: []

[Overwrite]
# 普通dns映射合并保留OpenClash从UCI加载的Policy。
# 随后只保留本模块列出的DNS字段和Policy，清掉旧fallback等残留。
ruby_edit "$CONFIG_FILE" "['dns']" "(Value['dns'] || {}).select { |k,_| ['enable', 'ipv6', 'enhanced-mode', 'listen', 'respect-rules', 'use-hosts', 'default-nameserver', 'nameserver', 'proxy-server-nameserver', 'direct-nameserver', 'nameserver-policy'].include?(k) }"
