    format: yaml
    path: ./rule_provider/google_drive.yaml
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/GoogleDrive/GoogleDrive.yaml
    interval: 86400

  google_search:
    type: http
    behavior: classical
    format: yaml
    path: ./rule_provider/google_search.yaml
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/GoogleSearch/GoogleSearch.yaml
    interval: 86400

  网易云音乐:
    type: http
    behavior: classical
    format: text
    path: ./rule_provider/NeteaseMusic.yaml
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/refs/heads/master/rule/Clash/NetEaseMusic/NetEaseMusic.list
    interval: 86400

  xiaohongshu:
    type: http
    behavior: classical
    format: text
    path: ./rule_provider/xiaohongshu.yaml
    url: https://raw.githubusercontent.com/zealler9560/my-clash-rules/refs/heads/main/Xiaohongshu.list
