  download_cdn_cn:
    type: http
    behavior: classical
    format: text
    path: ./rule_provider/download_cdn_cn.list
    url: https://raw.githubusercontent.com/Moli-X/Tool/refs/heads/X/Clash/Rules/DownloadCDN_CN.list
    interval: 86400

  wechat:
    type: http
    behavior: classical
    format: text
    path: ./rule_provider/wechat.list
    url: https://raw.githubusercontent.com/Moli-X/Tool/refs/heads/X/Clash/Rules/WeChat.list
