[YAML]
# 文件作用：为 YouTube 添加美国节点故障切换组，并挂接到视频策略组。
# Reuse every proxy-provider in the generated configuration.
# Provider subscription URLs, cache paths and update intervals stay in OpenClash.
# Mihomo registers this group's URL as an additional provider health-check task.
proxy-groups+:
  - name: "📹 YouTube专用自动"
    type: fallback
    include-all-providers: true
    filter: "(?i)(US-|美国)"
    url: https://www.youtube.com/generate_204
    interval: 300
    timeout: 5000
    expected-status: 204
    lazy: true

proxy-groups*:
  where:
    name: "📹 油管视频"
  set:
    +proxies:
      - "📹 YouTube专用自动"
